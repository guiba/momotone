/target/
**/*.rs.lock
*.pyc
__pycache__/
.DS_Store

# Large model / binary assets (download or generate locally)
assets/
*.onnx
*.zip
*.png
.zed/

# The fixture clip is a recording of a real hand, so it is generated locally by
# `make record` and never committed; neither is the trace recorded from it.
fixtures/*.mp4
fixtures/clip_trace.json

# The mock trace *is* committed: it is deterministic and needs no camera or
# models, so it is what CI can actually check.
